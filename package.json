    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "playwright": "^1.55.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
