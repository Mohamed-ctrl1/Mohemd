{
  "name": "hebrew-grammar-exam",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve-static.mjs 3000 \"\" out",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-bank.ts",
    "test": "npm run typecheck && npm run validate && npm run test:logic",
    "test:logic": "tsx scripts/test-logic.ts",
    "test:e2e": "node scripts/e2e.mjs",
    "build:pages": "NEXT_PUBLIC_BASE_PATH=/Mohemd next build && touch out/.nojekyll",
    "preview:pages": "node scripts/serve-static.mjs 4300 /Mohemd out",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.21",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "playwright": "^1.55.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
